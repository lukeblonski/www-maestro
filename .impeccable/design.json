  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "description": "Lime call to action; 51px minimum height, a small hover lift, and visible keyboard focus.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Join the first release<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-button-primary{font-family:'DM Sans',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:51px;padding:12px 22px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .2s,transform .2s;background:var(--lime,#d5f680);color:#1e3c23;}.ds-button-primary:hover{transform:translateY(-2px);background:#e2ffa2;}.ds-button-primary:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Ink action",
      "kind": "button",
      "description": "Theme-aware ink action. The live header uses the smaller 42px variant.",
      "html": "<button type=\"button\" class=\"ds-button-ink\">Join the first release<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-button-ink{font-family:'DM Sans',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:18px;min-height:51px;padding:12px 22px;border:1px solid transparent;border-radius:8px;font-size:14px;font-weight:600;line-height:1.45;cursor:pointer;transition:background .2s,transform .2s;background:var(--ink,#202b23);color:var(--paper,#fafbf7);}.ds-button-ink:hover{transform:translateY(-2px);background:var(--green,#286447);}.ds-button-ink:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-button-ink{transition:none}}",
      "refersTo": "button-ink-light"
    },
    {
      "name": "Forest form action",
      "kind": "button",
      "description": "Forest action used beside the waitlist field; colors inherit the current theme.",
      "html": "<button type=\"button\" class=\"ds-button-forest\">Join the first release<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
