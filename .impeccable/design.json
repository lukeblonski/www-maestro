    {
      "name": "Email field",
      "kind": "input",
      "description": "Visible email label, semantic validation, theme-aware field, and persistent explanatory copy. The live form currently returns preview only.",
      "html": "<div class=\"ds-field\"><label for=\"ds-email\">Email address</label><input id=\"ds-email\" name=\"email\" type=\"email\" autocomplete=\"email\" placeholder=\"you@example.com\" aria-describedby=\"ds-email-note\" required maxlength=\"254\"><p id=\"ds-email-note\">Form preview only. Sign-ups are not open here yet; nothing is sent or saved.</p></div>",
      "css": ".ds-field{font-family:'DM Sans',sans-serif;color:var(--ink,#202b23)}.ds-field label{font-size:12px;font-weight:600;display:block;margin-bottom:10px;line-height:1.6}.ds-field input{font-family:'DM Sans',sans-serif;border:1px solid var(--line,#dce2d8);background:var(--surface,#fff);color:var(--ink,#202b23);border-radius:8px;width:100%;min-width:0;min-height:51px;padding:12px 14px;font-size:13px;caret-color:var(--green,#286447)}.ds-field input::placeholder{color:var(--muted,#5c675e);opacity:1}.ds-field input:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;}.ds-field input[aria-invalid=true]{outline:2px solid var(--green,#286447);outline-offset:2px}.ds-field p{font-size:11px;color:var(--muted,#5c675e);margin:13px 0 0;line-height:1.6}",
      "refersTo": "input-light"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "description": "Muted section links on an opaque paper header, green hover text, and visible keyboard focus. The live header switches to the menu at 900px.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Main\"><a href=\"#how-it-works\">How it works</a><a href=\"#observer\">Your partner</a><a href=\"#ownership\">Your ownership</a><a href=\"#first-release\">First release</a></nav>",
      "css": ".ds-navigation{font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:26px;font-size:12px;background:var(--paper,#fafbf7);border-bottom:1px solid var(--line,#dce2d8)}.ds-navigation a{padding-block:12px;color:var(--muted,#5c675e);text-decoration:none;line-height:1.6;transition:color .2s}.ds-navigation a:hover{color:var(--green,#286447)}.ds-navigation a:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-navigation a{transition:none}}"
    },
    {
      "name": "Status tag",
      "kind": "chip",
      "description": "A static status annotation, not a filter or button.",
      "html": "<span class=\"ds-tag\">Planned</span>",
      "css": ".ds-tag{font-family:'DM Sans',sans-serif;display:inline-flex;padding:5px 10px;border:1px solid var(--line,#dce2d8);border-radius:5px;font-size:11px;font-weight:600;line-height:1.6;white-space:nowrap;color:var(--ink,#202b23)}",
      "refersTo": "tag"
    },
    {
      "name": "Observer bento surface",
      "kind": "card",
      "description": "A flat soft surface with the shared 16px radius and compact explanatory text.",
      "html": "<article class=\"ds-bento\"><h3>Your context, kept with you.</h3><p>Its lasting memory lives on your server. Your reasons, preferences and decisions stay available for the next conversation.</p></article>",
      "css": ".ds-bento{font-family:'DM Sans',sans-serif;background:var(--soft,#f0f3eb);color:var(--ink,#202b23);border-radius:var(--radius,16px);padding:32px}.ds-bento h3{margin:0;font-size:21px;font-weight:600;line-height:1.35;letter-spacing:-.02em;text-wrap:balance}.ds-bento p{font-size:14px;line-height:1.75;color:var(--muted,#5c675e);margin:10px 0 0}@media(max-width:900px){.ds-bento{padding:27px}}@media(max-width:700px){.ds-bento{padding:28px}.ds-bento h3{font-size:20px}}",
      "refersTo": "bento-light"
    },
    {
      "name": "Project step selector",
      "kind": "custom",
      "description": "Native buttons expose selection through aria-pressed. In the application they update the live example panel; the specimen shows both visual states.",
      "html": "<div class=\"ds-steps\" role=\"group\" aria-label=\"Step\"><button type=\"button\" class=\"ds-step ds-selected\" aria-pressed=\"true\"><span class=\"ds-number\">01</span><span>Start with the problem</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button><button type=\"button\" class=\"ds-step\" aria-pressed=\"false\"><span class=\"ds-number\">02</span><span>Decide what people will see</span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></div>",
      "css": ".ds-steps{display:flex;flex-direction:column;gap:5px;padding:4px 0;background:var(--soft,#f0f3eb)}.ds-step{font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:15px;text-align:left;padding:15px;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--ink,#202b23);font-size:13px;width:100%;line-height:1.5;min-height:56px;cursor:pointer;transition:background .2s}.ds-number{font-variant-numeric:tabular-nums;color:var(--muted,#5c675e);font-size:11px}.ds-step svg{margin-left:auto;opacity:0}.ds-step:hover{background:var(--surface,#fff)}.ds-step.ds-selected{background:var(--forest,#153c2f);color:var(--on-forest,#f3f7ee)}.ds-selected .ds-number,.ds-selected svg{color:var(--lime,#d5f680)}.ds-selected svg{opacity:1}.ds-step:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;}@media(max-width:700px){.ds-steps{display:grid;grid-template-columns:1fr 1fr;gap:7px}.ds-step{font-size:11px;min-height:64px;line-height:1.45;padding:10px;border:1px solid var(--line,#dce2d8);gap:8px}.ds-step svg{display:none}.ds-number{font-size:10px}}@media(prefers-reduced-motion:reduce){.ds-step{transition:none}}"
    },
    {
      "name": "Illustrative conversation",
      "kind": "custom",
      "description": "The signature conversation combines a user bubble, recommendation rule, and forest reply button. The live component adds approval/replay and a four-stage status track.",
      "html": "<figure class=\"ds-conversation\"><div class=\"ds-conversation-top\"><span class=\"ds-avatar\"><svg width=\"30\" height=\"30\" viewBox=\"0 0 32 32\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 25V13c0-4 3-6 6-6s6 2 6 6v12M16 25V13c0-4 3-6 6-6s6 2 6 6v12\" stroke=\"currentColor\" stroke-width=\"3.4\" stroke-linecap=\"round\"/><path d=\"M4 19h24\" stroke=\"currentColor\" stroke-width=\"2.2\"/></svg></span><div><strong>Observer</strong><span>Your idea, moving forward.</span></div></div><div class=\"ds-conversation-body\"><div class=\"ds-user\"><span class=\"ds-speaker\">You</span><p>I want to help people check the claims in YouTube videos.</p></div><div class=\"ds-observer\"><span class=\"ds-speaker\">Observer</span><p>What would help them most: a quick answer beside the video, or a detailed report elsewhere?</p><div class=\"ds-recommendation\"><span>Recommended</span><p>Start with a short answer beside the video, with evidence they can explore.</p></div><button class=\"ds-reply\" type=\"button\">Yes. Keep it simple.<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 10 4 15l5 5M20 4v7a4 4 0 0 1-4 4H4\"/></svg></button></div></div><figcaption>Illustrative conversation · based on a real project</figcaption></figure>",
      "css": ".ds-conversation{font-family:'DM Sans',sans-serif;margin:0;border-radius:14px;background:var(--surface,#fff);color:var(--ink,#202b23);box-shadow:var(--shadow,0 22px 60px -25px #1a392b38);overflow:hidden;line-height:1.6}.ds-conversation-top{display:flex;gap:11px;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line,#dce2d8)}.ds-avatar{width:36px;height:36px;background:var(--forest,#153c2f);color:var(--lime,#d5f680);display:grid;place-items:center;border-radius:10px}.ds-avatar svg{width:24px;height:24px}.ds-conversation-top strong{display:block;font-size:13px}.ds-conversation-top div>span{display:block;font-size:10px;color:var(--muted,#5c675e)}.ds-conversation-body{padding:22px 22px 20px;font-size:12px}.ds-user{background:var(--soft,#f0f3eb);border-radius:12px 12px 3px 12px;padding:13px 16px;width:84%;margin-left:auto}.ds-speaker{display:block;font-size:10px;font-weight:600;color:var(--muted,#5c675e);margin-bottom:7px}.ds-user p{font-size:13px;line-height:1.55;margin:0}.ds-observer{margin-top:22px}.ds-observer>p{font-size:13px;line-height:1.65;margin:0}.ds-recommendation{margin-top:14px;padding-left:13px;border-left:1px solid var(--green,#286447)}.ds-recommendation>span{font-size:10px;font-weight:600;color:var(--green,#286447)}.ds-recommendation p{margin:3px 0 0;color:var(--muted,#5c675e);font-size:12px}.ds-reply{font-family:'DM Sans',sans-serif;margin-top:17px;width:100%;background:var(--forest,#153c2f);color:var(--on-forest,#f3f7ee);border:0;border-radius:6px;padding:12px 14px;text-align:left;display:flex;justify-content:space-between;align-items:center;font-size:12px;cursor:pointer}.ds-reply:hover{background:#27583e}.ds-reply:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;outline-offset:3px}.ds-conversation figcaption{text-align:center;font-size:9px;color:var(--muted,#5c675e);margin-top:14px}"
    },
    {
      "name": "FAQ disclosure",
      "kind": "custom",
      "description": "Native details/summary behavior with a dividing rule and rotating chevron.",
      "html": "<details class=\"ds-faq\"><summary>Do I need to know how to code?<svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><p>No. You do not need to know what a PR, Node, TypeScript or VPS is. You describe the problem and make the choices that affect your product. Setup does involve pasting an installation command into your server provider’s browser terminal and signing in to your own accounts; the installer provides checks and guidance.</p></details>",
      "css": ".ds-faq{font-family:'DM Sans',sans-serif;border-top:1px solid var(--line,#dce2d8);border-bottom:1px solid var(--line,#dce2d8);color:var(--ink,#202b23)}.ds-faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:22px 0;cursor:pointer;font-size:15px;font-weight:600;line-height:1.5}.ds-faq summary::-webkit-details-marker{display:none}.ds-faq summary svg{color:var(--muted,#5c675e);transition:transform .2s}.ds-faq[open] summary svg{transform:rotate(180deg)}.ds-faq summary:focus-visible{outline:3px solid var(--green,#286447);outline-offset:5px;}.ds-faq p{margin:0;padding:0 30px 24px 0;color:var(--muted,#5c675e);font-size:13px;line-height:1.85}@media(prefers-reduced-motion:reduce){.ds-faq summary svg{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Warm paper, botanical green, precise rules",
    "overview": "The implemented interface combines generous headlines with compact, readable conversations. Warm pale surfaces and quiet rules establish structure; forest panels and a lime action color give decisions and progress more emphasis. The dark theme keeps the same hierarchy with lighter green text and deeper surfaces.",
    "keyCharacteristics": [
      "One botanical green accent family, from forest to lime.",
      "Self-hosted DM Sans throughout, with large, tightly spaced headings.",
      "Open sections, asymmetric bento surfaces, and visible conversational examples.",
      "Restrained movement that never hides essential content."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Reuse the existing green family for actions, emphasis, and status; communicate errors and progress with text, icons, and semantic state as well as color.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** reuse semantic CSS colors so both themes remain coherent.",
      "**Do** preserve visible labels, keyboard focus, state text, and reduced-motion behavior.",
      "**Do** keep illustrative conversations and mockups explicitly identified as examples.",
      "**Do** use the existing DM Sans hierarchy, open rules, and restrained surface depth."
    ],
    "donts": [
      "**Don't** introduce a second accent family or use color as the only state signal.",
      "**Don't** hide essential content behind scroll animations.",
      "**Don't** turn every section into a shadowed card or add generic hover lift to cards.",
      "**Don't** present the current waitlist preview as a successful subscription."
    ]
  }
}
